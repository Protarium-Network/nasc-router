[Unit]
Description=Pretendo account server (answers NASC for the self-hosted titles)
After=network.target

[Service]
User=nasc
WorkingDirectory=/opt/pn-account
# .env: PN_ACT_CONFIG_HTTP_PORT=7071, PN_ACT_CONFIG_DOMAINS_NASC=nasc.example.org, ...
ExecStart=/usr/bin/node .
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
